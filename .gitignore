__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# Python 3.11+ venvs write their own .gitignore, but 3.10 is supported and does
# not, and an accidentally committed venv is a couple of GB with torch in it.
.venv/
venv/
# setuptools/pip leave these behind whenever a wheel or sdist gets built
build/
dist/
memory.db
memory.db-*
policy.yaml
# the Claude integration's local config, for the same reason as policy.yaml:
# it belongs in ~/.memory-agent/, and a copy that lands in a checkout carries
# machine paths and project names into a public repo
claude.yaml
# build_plugin.py output, if someone points it at the repo
*.plugin
