{
  "$id": "https://mikeleewoodai.github.io/memory-champ/v1/memory_forget.input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": false
          },
          "mode": {
            "const": "hard_delete"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "confirm": {
            "const": true
          }
        },
        "required": [
          "confirm"
        ]
      }
    }
  ],
  "properties": {
    "confirm": {
      "default": false,
      "description": "Must be true for hard_delete. Ignored otherwise.",
      "type": "boolean"
    },
    "dry_run": {
      "default": false,
      "description": "Report what would be affected and change nothing.",
      "type": "boolean"
    },
    "max_records": {
      "description": "Abort without changes if the selector matches more than this.",
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "mode": {
      "default": "tombstone",
      "description": "One of: `tombstone`, `redact`, `hard_delete`.",
      "enum": [
        "tombstone",
        "redact",
        "hard_delete"
      ],
      "type": "string"
    },
    "reason": {
      "description": "Required and stored. A forget with no recorded reason is indistinguishable from data loss.",
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "$ref": "memory-envelope.schema.json#/$defs/scope"
    },
    "selector": {
      "additionalProperties": false,
      "description": "Exactly one selection method.",
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "filter": {
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "never_accessed": {
              "type": "boolean"
            },
            "older_than": {
              "$ref": "memory-envelope.schema.json#/$defs/timestamp"
            },
            "sensitivity": {
              "description": "One of: `none`, `pii`, `secret`.",
              "enum": [
                "none",
                "pii",
                "secret"
              ],
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "types": {
              "items": {
                "description": "One of: `episodic`, `semantic`, `procedural`.",
                "enum": [
                  "episodic",
                  "semantic",
                  "procedural"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "query": {
          "additionalProperties": false,
          "description": "Semantic selection. Always run with dry_run first \u2014 a fuzzy match is a poor basis for deletion.",
          "properties": {
            "min_similarity": {
              "default": 0.8,
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "text": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        "record_ids": {
          "items": {
            "$ref": "memory-envelope.schema.json#/$defs/uuid"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "scope",
    "selector",
    "reason",
    "max_records"
  ],
  "type": "object"
}
